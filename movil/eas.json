{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://prueba.vertigopro.tech"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://savora.vertigopro.tech"
      },
      "channel": "production"
    },
    "publico": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://savora.vertigopro.tech"
      },
      "channel": "publico"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6825954503"
      },
      "android": {
        "serviceAccountKeyPath": "./tienda/google-play/play-cuenta-servicio.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
