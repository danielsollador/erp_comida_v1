# Copiar a .env y ajustar.  docker compose lo lee automaticamente.

# Puerto del host donde queda la app completa (front + API detras de nginx).
APP_PORT=8090

# Zona horaria del contenedor: afecta cierres de caja y reportes por dia.
TZ=America/Caracas

# Respaldos automaticos de la base SQLite.
ERP_BACKUP_INTERVAL_HOURS=6
ERP_BACKUP_KEEP=60

# Origenes permitidos para CORS. Detras de nginx no hace falta abrirlo.
ERP_CORS_ORIGINS=*

# Solo para docker-compose.dev.yml
BACKEND_PORT=8011
FRONTEND_PORT=5181
