# Copiar a .env y ajustar.  docker compose lo lee automaticamente.

# Puerto del host donde queda la app completa (front + API detras de nginx).
# En produccion NO se usa: docker-compose.prod.yml lo quita y entra Traefik.
APP_PORT=8090

# Zona horaria del contenedor: afecta cierres de caja y reportes por dia.
TZ=America/Caracas

# Respaldos automaticos de la base SQLite.
ERP_BACKUP_INTERVAL_HOURS=6
ERP_BACKUP_KEEP=60

# Origenes permitidos para CORS. Detras de nginx no hace falta abrirlo.
ERP_CORS_ORIGINS=*

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────────
# OBLIGATORIA: sin ella el compose no arranca. Generar una larga:
#     openssl rand -base64 36
# La base no se publica fuera de la red de Docker; la clave solo la conocen
# los backends. Cada local trabaja en su propio esquema (ERP_LOCAL).
POSTGRES_PASSWORD=

# ── Acceso ──────────────────────────────────────────────────────────────────
# Que local sirve este panel (su ficha es locales/<slug>.json).
ERP_LOCAL=savora

# El secreto con el que se firman sesiones y pases. Si se deja VACIO se genera
# uno la primera vez y se guarda en el volumen compartido, que ya lo comparten
# el hub y el panel. En produccion conviene fijarlo igual, para que un volumen
# recreado no eche a todo el mundo:   openssl rand -base64 48
ERP_SESSION_SECRET=

# Siembra OPCIONAL del primer administrador. Se deja vacio: la primera visita
# al ERP pide crearlo desde el navegador (modo instalacion) y asi la clave no
# queda escrita en ningun archivo.
ERP_APP_USER=admin
ERP_APP_PASSWORD=

# ── Pabilo: verificar pagos moviles contra el banco ─────────────────────────
# La clave se genera en pabilo.app > Integraciones. ES SECRETA DE SERVIDOR:
# solo aqui, nunca en el frontend ni en el repositorio. Vacia = el mostrador
# cobra anotando la referencia a mano, como siempre.
PABILO_API_KEY=
# La cuenta bancaria donde cobra el local (el `id` de GET /me/usersbank o
# "Copiar ID de cuenta" en el panel). Vacia = la unica cuenta de la clave.
PABILO_USER_BANK_ID=

# Solo para docker-compose.dev.yml
BACKEND_PORT=8011
FRONTEND_PORT=5181
